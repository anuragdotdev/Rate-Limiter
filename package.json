{
  "name": "rate-limiter-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Simple Express backend with a Neon/Postgres connection via `pg`.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "nodemon": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\""
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "swagger-ui-express": "^4.6.3",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/winston": "^2.4.4",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
